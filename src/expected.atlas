//! Error handling without exceptions. `std::expected<T, E>` holds either a value or an error.
//!
//! This is the type most of the std uses to report failures (e.g. `std::file::open`, `std::any::cast<T>()`).

import "io.atlas";
import "memory.atlas";

namespace std {
    //! Storage for `expected<T, E>`.
    //!
    //! Holds either an `expected_value: T` when the computation succeeded,
    //! or an `unexpected_value: E` when it failed. Presence is tracked by
    //! `expected<T, E>::has_expected_value`.
    private union __expected_storage<T, E> { 
        expected_value: T;
        unexpected_value: E;
        empty: std::empty; // Sentinel for empty state when neither value is present
    }

    //! A result-like type representing either a value `T` or an error `E`.
    //!
    //! - Construct with `expected::expect(value)` for success or `expected::unexpected(error)` for failure.
    //! - Query with `is_expected()` / `is_unexpected()`.
    //! - Access with `expected_value()` / `unexpected_value()` or use
    //!   `expected_value_or(default)`.
    //! - Every accessor consumes the expected: once you took the value (or the error) out, the destructor won't touch it.
    //!
    //! ```
    //! let res = std::file::read_to_string("foo.txt");
    //! if res.is_unexpected() {
    //!     let err: std::string = res.unexpected_value();
    //! } else {
    //!     let content: std::string = res.expected_value();
    //! }
    //! ```
    public struct expected<T, E> {
    private:
        data: std::__expected_storage<T, E>;
        has_expected_value: bool;
        is_empty: bool; // Track if the expected is in an empty state (neither value is present)
    public:
        //! Drops whichever of the value or the error is still held. Does nothing if it has already been taken out.
        ~expected() {
            if (!this->is_empty) {
                if (this->has_expected_value) {
                    delete this->data.expected_value;
                } else {
                    delete this->data.unexpected_value;
                }
            }
        }
        //! Construct a successful `expected` containing `data`.
        //!
        //! ```
        //! let e = std::expected<int64, std::string>::expect(42);
        //! ```
        fun expect(data: T) -> std::expected<T, E> {
            return std::expected<T, E> {
                    .data = std::__expected_storage<T, E> { 
                        .expected_value = std::move(data) 
                    }, 
                    .has_expected_value = true,
                    .is_empty = false
                };
        }
        //! Construct a failing `expected` containing `error`.
        //!
        //! ```
        //! let e = std::expected<int64, std::string>::unexpected(std::string::from_chars("oops"));
        //! ```
        fun unexpected(error: E) -> std::expected<T, E> {
            return std::expected<T, E> {
                .data = std::__expected_storage<T, E> { 
                    .unexpected_value = std::move(error) 
                }, 
                .has_expected_value = false,
                .is_empty = false
            };
        }
        //! Returns true if this holds an expected value.
        fun is_expected(*const this) -> bool {
            return this->has_expected_value;
        }
        //! Returns true if this holds an unexpected error.
        fun is_unexpected(*const this) -> bool {
            return !this->has_expected_value;
        }
        //! Consume the expected and return the contained value, panicking if this is an unexpected error.
        //!
        //! Consider using `expected_value_or(default)` to avoid panics.
        fun expected_value(*this) -> T {
            if (!this->has_expected_value) {
                std::panic("called expected_value() on an unexpected error");
            } else {
                this->is_empty = true; // Prevent double delete in destructor
                let val = std::ptr::read(&this->data.expected_value);
                return val;
            }
        }
        //! Consume the expected and return the contained error, panicking if this is an expected value.
        //!
        //! Consider using `unexpected_value_or(default)` to avoid panics.
        fun unexpected_value(*this) -> E {
            if (this->has_expected_value) {
                std::panic("called unexpected_value() on an expected value");
            } else {
                this->is_empty = true; // Prevent double delete in destructor
                let val = std::ptr::read(&this->data.unexpected_value);
                return val;
            }
        }
        //! Consume the expected and return the contained value, or return `default` if this is an unexpected error.
        fun expected_value_or(*this, default: T) -> T {
            if (this->has_expected_value) {
                let val = std::ptr::read(&this->data.expected_value);
                this->is_empty = true; // Prevent double delete in destructor
                return val;
            } else {
                return default;
            }
        }

        //! Consume the expected and return the contained error, or return `default` if this is an expected value.
        fun unexpected_value_or(*this, default: E) -> E {
            if (!this->has_expected_value) {
                let val = std::ptr::read(&this->data.unexpected_value);
                this->is_empty = true; // Prevent double delete in destructor
                return val;
            } else {
                return default;
            }
        }

        //! `!res` returns true if this holds an expected value. Same as `is_expected()`.
        //!
        //! NB: The naming is confusing, it doesn't negate anything. It will probably change.
        operator not(*const this) -> bool {
            return this->is_expected();
        }

        //! `*res` consumes the expected and returns the contained value. Panics if this is an unexpected error.
        //!
        //! Same behaviour as `expected_value()`.
        operator deref(*this) -> T {
            if (!this->has_expected_value) {
                std::panic("called operator deref on an unexpected error");
            } else {
                this->is_empty = true; // Prevent double delete in destructor
                let val = std::ptr::read(&this->data.expected_value);
                return val;
            }
        }
    }
}
