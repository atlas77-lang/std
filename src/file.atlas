//! File system access. Reading and writing files, and iterating over the entries of a directory.
//!
//! Every fallible operation returns a `std::expected<_, std::string>` where the error is a human readable message.

import "optional.atlas";
import "expected.atlas";
import "memory.atlas";
import "string.atlas";
import "libc.atlas";

namespace std {
    //! How a file should be opened. Maps to the C `fopen` mode strings.
    public enum FILE_MODE {
        //! Read only, the file must exist (`"r"`)
        READ;
        //! Write only, the file is created or truncated (`"w"`)
        WRITE;
        //! Write only, at the end of the file, which is created if needed (`"a"`)
        APPEND;
        //! Read and write, the file must exist (`"r+"`)
        READ_WRITE;
    }

    //! An open file. Wrapper around a C `FILE*` that closes itself when destroyed.
    //!
    //! ```
    //! let res = std::file::open("foo.txt");
    //! if res.is_expected() {
    //!     let f = res.expected_value();
    //!     let content = f.read_all();
    //! }
    //! ```
    //!
    //! For the common "read the whole thing" case, `std::file::read_to_string(path)` does all of the above in one go.
    public struct file {
    private:
        handle: *libc::FILE;

    public:
        //! Closes the file if it's still open.
        ~file() {
            if this->handle != null {
                libc::fclose(this->handle);
                this->handle = null;
            }
        }

        //! Open file with explicit mode flag.
        //!
        //! On failure, the error is the message matching the C `errno`.
        fun open_with_mode(path: *const uint8, mode: std::FILE_MODE) -> std::expected<std::file, std::string> {
            let mode_str: *const uint8 = "r";
            if mode == std::FILE_MODE::WRITE {
                mode_str = "w";
            } else if mode == std::FILE_MODE::APPEND {
                mode_str = "a";
            } else if mode == std::FILE_MODE::READ_WRITE {
                mode_str = "r+";
            }

            let fs = libc::fopen(path, mode_str);
            if fs == null {
                return std::expected<std::file, std::string>::unexpected(
                    std::string::from_chars(libc::str_error(libc::errno()))
                );
            }
            return std::expected<std::file, std::string>::expect(std::file {
                .handle = fs
            });
        }

        //! Open file in read-only mode.
        fun open(path: *const uint8) -> std::expected<std::file, std::string> {
            return std::file::open_with_mode(path, std::FILE_MODE::READ);
        }

        //! Open file in write-only mode (truncating existing content).
        fun create(path: *const uint8) -> std::expected<std::file, std::string> {
            return std::file::open_with_mode(path, std::FILE_MODE::WRITE);
        }

        //! Returns true if the file at `path` exists and can be opened for reading.
        fun exists(path: *const uint8) -> bool {
            let result = libc::fopen(path, "rb");

            if result == null {
                return false;
            }

            libc::fclose(result);
            return true;
        }

        //! One-shot convenience function to read an entire file into a std::string.
        fun read_to_string(path: *const uint8) -> std::expected<std::string, std::string> {
            let file_res = std::file::open(path);
            if file_res.is_unexpected() {
                return std::expected<std::string, std::string>::unexpected(file_res.unexpected_value());
            }
            let f = file_res.expected_value();
            let content = f.read_all();
            return content;
        }

        //! Read the full content of an opened file handle into a std::string.
        //!
        //! The file is read from its start, whatever the current position was.
        fun read_all(*this) -> std::expected<std::string, std::string> {
            if this->handle == null {
                return std::expected<std::string, std::string>::unexpected(
                    std::string::from_chars("Invalid file handle")
                );
            }

            // Seek to EOF to measure byte length
            if libc::fseek(this->handle, 0, 2) != 0 {
                return std::expected<std::string, std::string>::unexpected(
                    std::string::from_chars("Failed to seek to end of file")
                );
            }

            let file_size = libc::ftell(this->handle);
            if file_size < 0 {
                return std::expected<std::string, std::string>::unexpected(
                    std::string::from_chars("Failed to determine file size")
                );
            }

            // Seek back to start
            if libc::fseek(this->handle, 0, 0) != 0 {
                return std::expected<std::string, std::string>::unexpected(
                    std::string::from_chars("Failed to seek to start of file")
                );
            }

            let size_u = file_size as uint64;
            let buffer = libc::malloc<uint8>(size_u + 1u);
            if buffer == null {
                return std::expected<std::string, std::string>::unexpected(
                    std::string::from_chars("Allocation failed for file buffer")
                );
            }

            let read_bytes = libc::fread(buffer, 1u, size_u, this->handle);
            buffer[read_bytes] = '\0' as uint8;

            let res_str = std::string::from_chars(buffer);
            libc::free(buffer);

            return std::expected<std::string, std::string>::expect(std::move(res_str));
        }

        //! Write raw byte buffer to file.
        //!
        //! Returns the number of bytes written, or an error if fewer than `size` bytes could be written.
        fun write(*this, buf: *const uint8, size: uint64) -> std::expected<uint64, std::string> {
            if this->handle == null {
                return std::expected<uint64, std::string>::unexpected(
                    std::string::from_chars("Invalid file handle")
                );
            }

            let written = libc::fwrite(buf, 1u, size, this->handle);
            if written < size {
                return std::expected<uint64, std::string>::unexpected(
                    std::string::from_chars(libc::str_error(libc::errno()))
                );
            }

            return std::expected<uint64, std::string>::expect(written);
        }

        //! Write an entire string to file.
        //!
        //! Returns the number of bytes written.
        fun write_all(*this, str_val: *const std::string) -> std::expected<uint64, std::string> {
            return this->write(str_val->c_str(), str_val->len());
        }

        //! Flush buffered file streams.
        //!
        //! Returns true on success, false if the file isn't open or the flush failed.
        fun flush(*this) -> bool {
            if this->handle == null {
                return false;
            }
            return libc::fflush(this->handle) == 0;
        }

        //! Obtain direct access to underlying opaque C file handle.
        //!
        //! The `std::file` still owns the handle and will close it, don't `fclose` it yourself.
        fun get_handle(*this) -> *libc::FILE {
            return this->handle;
        }
    }

    //! Opens the directory at `path` for iteration. Returns `null` on failure. Prefer `std::directory::open`.
    #[c_name("atlas_directory_open")]
    public extern fun atlas_directory_open(path: *const uint8) -> *unit;

    //! Returns the name of the next entry of the directory, or `null` once exhausted. Prefer `std::directory::next`.
    #[c_name("atlas_directory_next")]
    public extern fun atlas_directory_next(handle: *unit) -> *const uint8;

    //! Closes a directory handle obtained from `atlas_directory_open`.
    #[c_name("atlas_directory_close")]
    public extern fun atlas_directory_close(handle: *unit);

    //! An open directory, iterated entry by entry with `next()`.
    //!
    //! ```
    //! let res = std::directory::open(".");
    //! if res.is_expected() {
    //!     let dir = res.expected_value();
    //!     let entry = dir.next();
    //!     while entry.has_value() {
    //!         std::println(entry.value().c_str() as str);
    //!         entry = dir.next();
    //!     }
    //! }
    //! ```
    //!
    //! NB: `.` and `..` are returned like any other entry. The order of the entries is whatever the OS gives.
    public struct directory {
      private:
        handle: *unit;

      public:
        //! Open a directory for iteration.
        fun open(
            path: *const uint8
        ) -> std::expected<std::directory, std::string> {

            let handle = std::atlas_directory_open(path);

            if handle == null {
                return std::expected<std::directory, std::string>::unexpected(
                    std::string::from_chars(
                        "Failed to open directory"
                    )
                );
            }

            return std::expected<std::directory, std::string>::expect(
                std::directory {
                    .handle = handle
                }
            );
        }

        //! Advance the iterator and return the next entry's file name,
        //! or an empty optional once the directory is exhausted (or was
        //! never successfully opened).
        fun next(*this) -> std::optional<std::string> {
            if this->handle == null {
                return std::optional<std::string>::empty();
            }

            let name = std::atlas_directory_next(this->handle);

            if name == null {
                return std::optional<std::string>::empty();
            }

            return std::optional<std::string>::of(std::string::from_chars(name));
        }
        //! Closes the directory if it's still open.
        ~directory() {
            if this->handle != null {
                std::atlas_directory_close(
                    this->handle
                );

                this->handle = null;
            }
        }
    }
}
