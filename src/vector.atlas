//! Growable, heap allocated array. The go-to container of the std.

import "io.atlas";
// We need to import mem to use memcpy for the try_take function
import "memory.atlas";
import "optional.atlas";

namespace std {
    //! A contiguous, growable array of `T`.
    //!
    //! Elements are stored in a single heap buffer of `capacity` slots, of which the first `length` are valid.
    //! Pushing past the capacity reallocates the buffer, doubling its size.
    //! The destructor deletes every element in `[0, length)` before freeing the buffer.
    //!
    //! ```
    //! let v = std::vector<int64>::with_capacity(4);
    //! v.push(1);
    //! v.push(2);
    //! let last = v.pop(); // 2
    //! let first = *v.get(0); // 1
    //! ```
    //!
    //! Indexing goes through the `std::indexable` conformance (`get`/`get_mut`), see below.
    public struct vector<T> {
    private:    
        data: *T;
    public:
        //! Number of valid elements. Prefer `len()`, this field will become private at one point.
        length: uint64;
        //! Number of slots in the underlying buffer. Prefer `capacity()`, this field will become private at one point.
        capacity: uint64;

        //! Creates a new vector by copying `len` elements starting at `ptr`.
        //!
        //! The elements are copied bitwise with `memcpy`, so the vector ends up owning a copy of them.
        //! Be careful with types that own resources: both the original and the copy will run their destructor.
        fun new(ptr: *T, len: uint64) -> std::vector<T> {
            let data = libc::malloc<T>(sizeof<T>() * len);
            libc::memcpy(data, ptr, sizeof<T>() * len);
            return std::vector<T> {
                .data = data,
                .length = len,
                .capacity = len, // We assume the capacity is equal to the initial length
            };
        }
        //! Deletes every element in `[0, length)`, then frees the buffer.
        ~vector() {
            // We shouldn't delete anything outside of data[0..length]
            let i: uint64 = 0u;
            while i < this->length {
                delete this->data[i];
                i = i + 1u;
            }
            if this->data != null {
                libc::free(this->data);
            }
        }
        //! Creates a new std::vector with the specified capacity.
        //!
        //! The vector is empty, `capacity` only tells how many elements can be pushed before a reallocation happens.
        fun with_capacity(capacity: uint64) -> std::vector<T> {
            let data = libc::malloc<T>(size_of<T>() * capacity);
            return std::vector<T> {
                .data = data,
                .length = 0u,
                .capacity = capacity,
            };
        }
        //! Returns the number of elements in the vector.
        fun len(*const this) -> uint64 {
            return this->length;
        }
        //! Returns the number of elements the vector can hold before it needs to reallocate.
        fun capacity(*const this) -> uint64 {
            return this->capacity;
        }
        //! Sets the element at `index` to `val`.
        //! Panics on out-of-bounds access.
        //!
        //! NB: The previous element is overwritten without running its destructor.
        fun set(*this, index: uint64, val: T) {
            if index >= this->length {
                std::panic("Index out of bounds");
            }
            this->data[index] = val;
        }

        //! Appends `val` to the end of the vector, resizing if necessary.
        //!
        //! Panics if the reallocation fails.
        fun push(*this, val: T) {
            if this->length >= this->capacity {
                // Let's use `libc::realloc` to resize the data buffer
                // We double the capacity to amortize the cost of resizing
                let new_capacity = this->capacity;
                if new_capacity == 0u {
                    new_capacity = 1u;
                } else {
                    new_capacity = new_capacity * 2u;
                }
                let new_data = libc::realloc<T>(this->data, size_of<T>() * new_capacity);
                if new_data == null {
                    std::panic("Failed to allocate memory for vector resizing");
                }
                this->data = new_data;
                this->capacity = new_capacity;
            }
            std::ptr::write(&this->data[this->length], val);
            this->length = this->length + 1u;
        }
        //! Appends all elements from `vec` to the end of this vector, resizing if necessary.
        //!
        //! The elements are moved out of `vec`, which is left empty. Panics if the allocation fails.
        fun append(*this, vec: std::vector<T>) {
            let old_length: uint64 = this->length;
            let vec_length: uint64 = vec.length;
            let new_length: uint64 = old_length + vec_length;

            if new_length == 0u {
                return;
            }

            let new_data = libc::malloc<T>(size_of<T>() * new_length);
            if new_data == null {
                std::panic("Failed to allocate memory for vector extension");
            }

            // Move existing elements.
            let i: uint64 = 0u;
            while i < old_length {
                let value: T = std::ptr::read(&this->data[i]);
                std::ptr::write(&new_data[i], std::move(value));
                i = i + 1u;
            }

            // Move appended elements.
            i = 0u;
            while i < vec_length {
                let value: T = std::ptr::read(&vec.data[i]);
                std::ptr::write(&new_data[old_length + i], std::move(value));
                i = i + 1u;
            }

            libc::free(this->data);
            libc::free(vec.data);

            vec.data = null;
            vec.length = 0u;
            vec.capacity = 0u;

            this->data = new_data;
            this->length = new_length;
            this->capacity = new_length;
        }

        //! Removes and returns the last element of the vector.
        //! Panics when the vector is empty.
        fun pop(*this) -> T {
            if this->length == 0u {
                std::panic("Cannot pop from an empty vector");
            }
            let popped = std::ptr::read(&this->data[this->length - 1u]);
            this->length = this->length - 1u;
            return popped;
        }

        //! Inserts `val` at index `i`, shifting every element after it to the right.
        //!
        //! `i` can be equal to `len()`, in which case this behaves like `push`.
        //! Panics if `i` is greater than `len()`, or if the reallocation fails.
        fun insert(*this, i: uint64, val: T) {
            if i > this->length {
                std::panic("Index out of bounds");
            }
            if this->length >= this->capacity {
                // Resize the vector if necessary
                let new_capacity = 1u;
                if this->capacity != 0u { 
                    new_capacity = this->capacity * 2u;
                }
                let new_data = libc::realloc<T>(this->data, size_of<T>() * new_capacity);
                if new_data == null {
                    std::panic("Failed to allocate memory for vector resizing");
                }
                this->data = new_data;
                this->capacity = new_capacity;
            }
            // Shift elements to the right to make space for the new element
            let j: uint64 = this->length;
            while j > i {
                this->data[j] = this->data[j - 1u];
                j = j - 1u;
            }
            std::ptr::write(&this->data[i], val);
            this->length = this->length + 1u;
        }

        //! Takes an element out of the vector at the specified index,
        //! shifting subsequent elements to the left.
        //!
        //! Panics on out-of-bounds access.
        fun take(*this, index: uint64) -> T {
            // Public method to take an element out of the vector
            let result: std::optional<T> = this->try_take(index);
            if result.is_empty() {
                std::panic("Index out of bounds");
            }
            return result.value();
        }

    private:
        //! Internal: tries to take an element at `index`, returning an optional.
        fun try_take(*this, index: uint64) -> std::optional<T> {
            if index >= this->length {
                return std::optional<T>::empty();
            }
            let item: T = std::ptr::read(&this->data[index]);
            // Shift elements to fill the gap
            let i: uint64 = index;
            while i + 1u < this->length {
                this->data[i] = this->data[i + 1u];
                i = i + 1u;
            }
            this->length = this->length - 1u;
            return std::optional<T>::of(item);
        }
    }

    //! Index a vector with a `uint64`, giving back a pointer to the element. Out-of-bounds access panics.
    extend std::vector<T> with std::indexable {
        type index_t = uint64;
        type index_val_t = T;
        //! Returns a const pointer to the element at `index`.
        //! Panics on out-of-bounds access.
        fun get(*const this, index: This::index_t) -> *const This::index_val_t {
            if index >= this->length {
                std::panic("Index out of bounds");
            }
            return &this->data[index];
        }
        //! Returns a mutable pointer to the element at `index`.
        //! Panics on out-of-bounds access.
        fun get_mut(*this, index: This::index_t) -> *This::index_val_t {
            if index >= this->length {
                std::panic("Index out of bounds");
            }
            return &(this->data[index]);
        }
    }
}
