//! `std::default`: the "zero" value of a type, through `T::default()`.

namespace std {
    //! Types that have a sensible "zero" value, obtained through `T::default()`.
    //!
    //! Numbers default to `0`, `bool` to `false`, `char` to `'\0'`, `str` to `""` and every pointer type to `null`.
    //! Needed by `std::take<T>()`, which has to leave something valid behind once it took the value out.
    //!
    //! ```
    //! let n = int64::default(); // 0
    //! let s = std::string::default(); // ""
    //! ```
    public concept default {
        //! Returns the default value of the type.
        fun default() -> This;
    }
    extend *T with std::default {
        fun default() -> This {
            return null;
        }
    }
    extend *const T with std::default {
        fun default() -> This {
            return null;
        }
    }
    extend [T] with std::default {
        fun default() -> This {
            return null;
        }
    }
    extend int8 with std::default {
        fun default() -> This {
            return 0;
        }
    }
    extend int16 with std::default {
        fun default() -> This {
            return 0;
        }
    }
    extend int32 with std::default {
        fun default() -> This {
            return 0;
        }
    }
    extend int64 with std::default {
        fun default() -> This {
            return 0;
        }
    }
    extend uint8 with std::default {
        fun default() -> This {
            return 0;
        }
    }
    extend uint16 with std::default {
        fun default() -> This {
            return 0;
        }
    }
    extend uint32 with std::default {
        fun default() -> This {
            return 0;
        }
    }
    extend uint64 with std::default {
        fun default() -> This {
            return 0;
        }
    }
    extend float32 with std::default {
        fun default() -> This {
            return 0.0;
        }
    }
    extend float64 with std::default {
        fun default() -> This {
            return 0.0;
        }
    }
    extend bool with std::default {
        fun default() -> This {
            return false;
        }
    }
    extend char with std::default {
        fun default() -> This {
            return 0 as char;
        }
    }
    extend str with std::default {
        fun default() -> This {
            return "";
        }
    }
}
