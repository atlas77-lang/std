//! Standard input/output. Printing, reading a line from the terminal and panicking.
//!
//! Formatting is not implemented yet, so most of this is a thin layer above `printf`.

import "libc.atlas";
import "string.atlas";

private extern fun atlas77_get_stdin_impl() -> *libc::FILE;
private extern fun atlas77_get_stdout_impl() -> *libc::FILE;
private extern fun atlas77_get_stderr_impl() -> *libc::FILE;
private extern fun atlas77_input_impl(buf: *uint8, size: uint64) -> uint64;


namespace std {
    //! Handle over the standard input stream.
    //!
    //! Mostly a placeholder for now, `std::input()` is the easiest way to read from the terminal.
    public struct Stdin {
        file_handle: *libc::FILE;
    public:
        //! Reads up to `size` bytes from standard input into `buf`. Returns the number of bytes actually read.
        fun read(*this, buf: *uint8, size: uint64) -> uint64 {
            return atlas77_input_impl(buf, size);
        }
        //! Closes the underlying file handle.
        ~Stdin() {
            libc::fclose(this->file_handle);
        }
    }

    //! Read a line from standard input
    //!
    //! Reads until a newline or the end of the input. The newline itself isn't part of the returned string.
    //! ```
    //! let input = std::input();
    //! ```
    public fun input() -> std::string {
        let buf = std::string::with_capacity(16);
        let ch = libc::get_char();
        while (ch != '\n' && ch != libc::EOF()) {
            buf.push_char(ch);

            ch = libc::get_char();
        }
        
        return buf;
    }

    //! Panic the program with a value
    //!
    //! Prints the message and aborts the program. Nothing is cleaned up, no destructor is run.
    //! ```
    //! std::panic("Something went wrong!");
    //! ```
    #[c_name("panic")]
    public extern fun panic(s: *const uint8);

    //! Well, still needs to be worked on...
    //!
    //! Direct binding to the C `printf`, restricted to a single value. `fmt` is a C format string,
    //! so it's up to you to pass a specifier matching the type of `s`.
    // TODO: Once I implement the formatting system
    // I'll put that into libc
    #[c_name("printf")]
    public extern fun printf<T>(fmt: *const uint8, s: T);
    //! Print a value without a newline
    //! ```
    //! std::print("Hello, ");
    //! std::print("World!");
    //! ```
    public fun print(s: str) {
        std::printf("%s" as *const uint8, s);
    }

    //! Print a value followed by a newline
    //! ```
    //! std::println("Hello, World!");
    //! ```
    public fun println(s: str) {
        std::printf("%s\n" as *const uint8, s);
    }
}
