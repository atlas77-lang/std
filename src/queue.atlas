//! **Outdated**. Ring buffer FIFO queue on top of `std::vector<T>`. Not imported by `lib.atlas`, don't use it.


import "io.atlas";
import "memory.atlas";
import "optional.atlas";
import "vector.atlas";
namespace std {
//! A simple FIFO queue data structure.
//!
//! **Outdated**: `enqueue` doesn't store the item and there is no `dequeue`. It needs to be rewritten.
//!
//! TODO: Add a way to allow for other containers to be used inside of the queue.
public struct queue<T> {
    private:
        items: std::vector<T>;
        //! The index of the head of the queue.
        head: uint64;
        //! The index of the tail of the queue.
        tail: uint64;
        //! The number of items in the queue.
        count: uint64;
    public:
        //! Creates a new queue by copying `len` items starting at `items`.
        fun new(items: *T, len: uint64) -> std::queue<T> {
            return std::queue<T> {
                .items = std::vector<T>::new(items, len),
                .head = 0u,
                .tail = len,
                .count = len,
            };
        }
        ~queue() {

        }
        //! Creates an empty queue able to hold `capacity` items.
        fun with_capacity(capacity: uint64) -> std::queue<T> {
            return std::queue<T> {
                .items = std::vector<T>::with_capacity(capacity),
                .head = 0u,
                .tail = 0u,
                .count = 0u,
            };
        }
        //! Adds an item to the back of the queue. Panics if the queue is full.
        //!
        //! NB: The item isn't actually written anywhere yet, only the indices move.
        fun enqueue(*this, item: T) {
            if this->count == this->items.capacity() {
                std::panic("Queue is full");
            }
            
            this->tail = (this->tail + 1u) % this->items.capacity();
            this->count = this->count + 1u;
        }
    }

}